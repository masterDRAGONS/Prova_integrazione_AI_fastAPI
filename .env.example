# 🔧 Google Gemini API Configuration
GEMINI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 🔐 JWT Security Configuration
# IMPORTANTE: Cambia questa chiave in produzione con una stringa casuale sicura (min 256 bits)
SECRET_KEY=your-very-long-random-secret-key-change-in-production-min-256-bits

# JWT Algorithm
ALGORITHM=HS256

# 🐘 PostgreSQL Database URL
# Formato: postgresql+psycopg://user:password@host:port/database
# Sostituisci:
#   - user: utente PostgreSQL (default: postgres)
#   - password: password PostgreSQL
#   - host: indirizzo server (default: localhost)
#   - port: porta PostgreSQL (default: 5432)
#   - database: nome database (default: chat_ai_db)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/chat_ai_db

# 🚦 Rate Limiting Configuration

# Per utenti autenticati
AUTH_RATE_LIMIT=5
AUTH_TIME_WINDOW_SECONDS=60

# Per utenti non autenticati (globali)
GLOBAL_RATE_LIMIT=3
GLOBAL_TIME_WINDOW_SECONDS=60
